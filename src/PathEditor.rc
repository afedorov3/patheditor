/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_PATHEDITOR_DIALOG DIALOGEX 0, 0, 411, 276
STYLE DS_SETFONT | DS_3DLOOK | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Path Editor"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_LIST_USER,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | LVS_ALIGNLEFT | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,12,17,387,84
    CONTROL         "",IDC_LIST_SYSTEM,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | LVS_ALIGNLEFT | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,12,143,387,84
    PUSHBUTTON      "Add",IDC_BUTTON_USER_ADD,33,106,48,16
    PUSHBUTTON      "Edit",IDC_BUTTON_USER_EDIT,86,106,48,16
    PUSHBUTTON      "Remove",IDC_BUTTON_USER_REMOVE,139,106,48,16
    PUSHBUTTON      "Up",IDC_BUTTON_USER_UP,238,106,48,16
    PUSHBUTTON      "Down",IDC_BUTTON_USER_DOWN,289,106,48,16
    PUSHBUTTON      "Add",IDC_BUTTON_SYSTEM_ADD,33,232,48,16
    PUSHBUTTON      "Edit",IDC_BUTTON_SYSTEM_EDIT,86,232,48,16
    PUSHBUTTON      "Remove",IDC_BUTTON_SYSTEM_REMOVE,139,232,48,16
    PUSHBUTTON      "Up",IDC_BUTTON_SYSTEM_UP,238,233,48,16
    PUSHBUTTON      "Down",IDC_BUTTON_SYSTEM_DOWN,289,233,48,16
    CTEXT           "",IDC_STATIC_STATUS,35,258,84,14,WS_CHILD | SS_NOPREFIX
    PUSHBUTTON      "OK",IDC_BUTTON_OK,126,258,48,14
    PUSHBUTTON      "Apply",IDC_BUTTON_APPLY,182,258,48,14
    PUSHBUTTON      "Cancel",IDCANCEL,237,258,48,14
    PUSHBUTTON      "",IDC_BUTTON_REFRESH,12,258,16,14,BS_ICON
    GROUPBOX        "System",IDC_STATIC_SYSTEM,7,132,397,121
    GROUPBOX        "User",IDC_STATIC_USER,7,7,397,121
    PUSHBUTTON      "To edit System PATH\rLaunch as Admin",IDC_BUTTON_GAIN_PRIVILEGE,163,168,85,22,BS_MULTILINE
END

