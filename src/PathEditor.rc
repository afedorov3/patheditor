    VK_DELETE,      ID_ACC_CUT_ITEM,        VIRTKEY, SHIFT,   NOINVERT
    "V",            ID_ACC_PASTE_ITEM,      VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_ACC_PASTE_ITEM,      VIRTKEY, SHIFT,   NOINVERT
    VK_F2,          ID_ACC_EDIT_ITEM,       VIRTKEY,          NOINVERT
    VK_INSERT,      ID_ACC_INSERT_ITEM,     VIRTKEY,          NOINVERT
    VK_DELETE,      ID_ACC_DELETE_ITEM,     VIRTKEY,          NOINVERT
